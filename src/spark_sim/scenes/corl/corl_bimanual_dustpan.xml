<mujoco model="corl_bimanual_dustpan">
  <!--
    CoRL bimanual dustpan sweep task.
      - Left Panda arm at (0, +0.32, 0): holds the dustpan
      - Right Panda arm at (0, -0.32, 0): sweeps with brush
      - Dustpan: composite tray with 3 walls, open front with detectable sites
      - Debris: 4 small cubes scattered near the dustpan opening
      - Brush: graspable handle + bristle plate for sweeping

    The dustpan has two key sites:
      dustpan_opening_site -- centre of the open edge
      dustpan_center_site  -- centre of the pan
    Sweep direction = normalize(center - opening) pushes debris INTO the pan.

    Dustpan handle is positioned for left-arm top-down grasp.
    Dustpan opening faces +X (toward the right arm's workspace).
  -->

  <compiler angle="radian" autolimits="true"
            meshdir="../../../mujoco_menagerie/franka_emika_panda/assets"/>

  <option integrator="implicitfast"/>

  <include file="_panda_left.xml"/>
  <include file="_panda_right.xml"/>

  <visual>
    <headlight diffuse="0.5 0.5 0.5" ambient="0.25 0.25 0.25" specular="0.1 0.1 0.1"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="135" elevation="-25" offwidth="800" offheight="600"/>
  </visual>

  <statistic center="0.4 0 0.5" extent="1.5"/>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.8"
             rgb2="0.1 0.2 0.4" width="512" height="3072"/>
    <texture type="2d" name="lab_floor" builtin="checker"
             rgb1="0.35 0.4 0.45" rgb2="0.25 0.3 0.35" width="512" height="512"
             mark="cross" markrgb="0.8 0.8 0.9"/>
    <material name="groundplane" texture="lab_floor" texrepeat="20 20"
              reflectance="0.3" shininess="0.1"/>

    <!-- Table: light wood -->
    <material name="table_mat" rgba="0.85 0.75 0.6 1"
              reflectance="0.15" shininess="0.2" specular="0.1"/>

    <!-- Dustpan: dark gray with handle -->
    <material name="dustpan_mat" rgba="0.3 0.3 0.3 1"
              specular="0.3" shininess="0.2" reflectance="0.1"/>
    <material name="dustpan_wall_mat" rgba="0.35 0.35 0.35 1"
              specular="0.3" shininess="0.2" reflectance="0.1"/>
    <material name="dustpan_handle_mat" rgba="0.5 0.4 0.3 1"
              specular="0.2" shininess="0.15" reflectance="0.05"/>

    <!-- Brush: light brown handle, dark brown bristles -->
    <material name="brush_handle_mat" rgba="0.7 0.5 0.3 1"
              specular="0.2" shininess="0.1" reflectance="0.05"/>
    <material name="brush_bristle_mat" rgba="0.4 0.25 0.1 1"
              specular="0.05" shininess="0.02" reflectance="0.01"/>

    <!-- Debris: 4 bright distinct colors -->
    <material name="debris_red" rgba="1 0 0 1"
              specular="0.4" shininess="0.3"/>
    <material name="debris_blue" rgba="0 0 1 1"
              specular="0.4" shininess="0.3"/>
    <material name="debris_green" rgba="0 0.8 0 1"
              specular="0.4" shininess="0.3"/>
    <material name="debris_yellow" rgba="1 1 0 1"
              specular="0.4" shininess="0.3"/>
  </asset>

  <worldbody>
    <light pos="0 0 4" dir="0 0 -1" directional="true" diffuse="0.5 0.5 0.5"/>
    <light pos="2 2 3" dir="-0.5 -0.5 -1" diffuse="0.3 0.3 0.3"/>
    <light pos="0 -2 3" dir="0 0.5 -1" diffuse="0.2 0.2 0.2"/>
    <geom name="floor" size="10 10 0.01" type="plane" material="groundplane"/>

    <!-- Table: 900x600x20mm to span both arms' workspaces.
         Surface at z=0.42. -->
    <body name="table" pos="0.50 0 0.41">
      <geom name="table_top" type="box" size="0.45 0.30 0.01"
            pos="0 0 0" material="table_mat"
            friction="1.0 0.5 0.0001"/>
      <!-- Table legs -->
      <geom name="leg1" type="cylinder" size="0.02 0.20" pos="-0.40 -0.26 -0.21"
            rgba="0.6 0.5 0.4 1" contype="0" conaffinity="0"/>
      <geom name="leg2" type="cylinder" size="0.02 0.20" pos="0.40 -0.26 -0.21"
            rgba="0.6 0.5 0.4 1" contype="0" conaffinity="0"/>
      <geom name="leg3" type="cylinder" size="0.02 0.20" pos="-0.40 0.26 -0.21"
            rgba="0.6 0.5 0.4 1" contype="0" conaffinity="0"/>
      <geom name="leg4" type="cylinder" size="0.02 0.20" pos="0.40 0.26 -0.21"
            rgba="0.6 0.5 0.4 1" contype="0" conaffinity="0"/>
    </body>

    <!--
      Dustpan: welded to world. Positioned on table surface (z=0.42)
      centered between the two arms (Y=0) so both can reach.
      Opening faces +X direction (toward the debris).

      Geometry (body frame, origin at base plate center bottom):
        Base plate: 150x120x3mm
        Back wall: at -X edge (the closed back), 25mm tall
        Left wall: at -Y edge, 20mm tall
        Right wall: at +Y edge, 20mm tall
        Open front: +X edge (no wall -- this is the opening)
        Handle: extends from back wall center, graspable box

      Key sites:
        dustpan_opening_site: centre of open +X edge (mid-height)
        dustpan_center_site:  centre of the pan base
    -->
    <body name="dustpan" pos="0.35 -0.05 0.42">
      <!-- Base plate: 150x120x3mm -->
      <geom name="dustpan_base" type="box" size="0.075 0.06 0.0015"
            pos="0 0 0.0015" material="dustpan_mat"
            friction="0.8 0.4 0.001"/>
      <!-- Back wall: at -X edge, 150-wide along Y, 25mm tall -->
      <geom name="dustpan_back" type="box" size="0.0015 0.06 0.0125"
            pos="-0.0735 0 0.0155" material="dustpan_wall_mat"
            friction="0.8 0.4 0.001"/>
      <!-- Left wall (Y-): 150x3x20mm -->
      <geom name="dustpan_left" type="box" size="0.075 0.0015 0.01"
            pos="0 -0.0585 0.013" material="dustpan_wall_mat"
            friction="0.8 0.4 0.001"/>
      <!-- Right wall (Y+): 150x3x20mm -->
      <geom name="dustpan_right" type="box" size="0.075 0.0015 0.01"
            pos="0 0.0585 0.013" material="dustpan_wall_mat"
            friction="0.8 0.4 0.001"/>
      <!-- Front lip: thin 1mm lip at +X edge to help scoop -->
      <geom name="dustpan_front_lip" type="box" size="0.0015 0.06 0.001"
            pos="0.0735 0 0.001" material="dustpan_wall_mat"
            friction="0.8 0.4 0.001"/>
      <!-- Handle: extends from back wall (-X direction), graspable box -->
      <geom name="dustpan_handle" type="box" size="0.06 0.0075 0.008"
            pos="-0.135 0 0.012" material="dustpan_handle_mat"
            condim="6" friction="1.5 0.8 0.002"/>

      <!-- Key sites for sweep direction computation -->
      <site name="dustpan_opening_site" pos="0.075 0 0.005" size="0.008"
            rgba="0 1 0 0.3"/>
      <site name="dustpan_center_site" pos="0 0 0.005" size="0.008"
            rgba="1 0 0 0.3"/>
    </body>

    <!--
      Brush: freejoint for right arm to grasp.
      Placed in the right arm's workspace area.
    -->
    <body name="brush" pos="0.45 -0.15 0.42">
      <freejoint name="brush_free"/>
      <!-- Bristle plate: 120x30x12mm -->
      <geom name="brush_bristle" type="box" size="0.06 0.015 0.006"
            pos="0 0 0.006" material="brush_bristle_mat"
            condim="6" friction="2.0 1.0 0.003"
            solimp="0.9 0.95 0.005" solref="0.02 1"/>
      <!-- Bristle fringe -->
      <geom name="brush_fringe" type="box" size="0.058 0.016 0.003"
            pos="0 0 0.003" rgba="0.25 0.15 0.05 1"
            condim="6" friction="2.0 1.0 0.003"
            solimp="0.9 0.95 0.005" solref="0.02 1"/>
      <!-- Handle block: 30x20x40mm on top of bristle plate.
           Width (Y) = 20mm so Panda fingers (40mm max) grip securely. -->
      <geom name="brush_handle" type="box" size="0.015 0.010 0.020"
            pos="0 0 0.032" material="brush_handle_mat"
            condim="6" friction="3.0 1.5 0.005"
            solimp="0.95 0.99 0.003" solref="0.01 1"/>
      <inertial pos="0 0 0.02" mass="0.05"
                diaginertia="0.00003 0.00002 0.00002"/>
    </body>

    <!--
      Debris: 4 cubes (22mm = 0.011 half-size), scattered in front of
      the dustpan opening. The opening is at dustpan_pos + (0.075, 0, 0)
      in world = (0.525, 0.10, 0.42). Debris scattered at X > 0.525
      (in front of the opening).
    -->
    <!--
      Debris: 4 cubes (22mm side), scattered in front of the dustpan
      opening. Positioned closer to center (Y near 0) so the right arm
      at (0, -0.32, 0) can reach them comfortably.
      Opening is at dustpan (0.42,0.05) + (0.075,0) = (0.495, 0.05).
      Debris is at X > 0.49, Y in [-0.05, 0.10] range.
    -->
    <body name="debris_1" pos="0.45 -0.10 0.431">
      <freejoint name="debris_1_free"/>
      <geom name="debris_1_geom" type="box" size="0.011 0.011 0.011"
            material="debris_red"
            condim="6" friction="0.6 0.3 0.001"
            solimp="0.9 0.95 0.003" solref="0.02 1"
            mass="0.010"/>
      <inertial pos="0 0 0" mass="0.010"
                diaginertia="8e-7 8e-7 8e-7"/>
    </body>

    <body name="debris_2" pos="0.47 -0.12 0.431">
      <freejoint name="debris_2_free"/>
      <geom name="debris_2_geom" type="box" size="0.011 0.011 0.011"
            material="debris_blue"
            condim="6" friction="0.6 0.3 0.001"
            solimp="0.9 0.95 0.003" solref="0.02 1"
            mass="0.010"/>
      <inertial pos="0 0 0" mass="0.010"
                diaginertia="8e-7 8e-7 8e-7"/>
    </body>

    <body name="debris_3" pos="0.43 -0.14 0.431">
      <freejoint name="debris_3_free"/>
      <geom name="debris_3_geom" type="box" size="0.011 0.011 0.011"
            material="debris_green"
            condim="6" friction="0.6 0.3 0.001"
            solimp="0.9 0.95 0.003" solref="0.02 1"
            mass="0.010"/>
      <inertial pos="0 0 0" mass="0.010"
                diaginertia="8e-7 8e-7 8e-7"/>
    </body>

    <body name="debris_4" pos="0.46 -0.16 0.431">
      <freejoint name="debris_4_free"/>
      <geom name="debris_4_geom" type="box" size="0.011 0.011 0.011"
            material="debris_yellow"
            condim="6" friction="0.6 0.3 0.001"
            solimp="0.9 0.95 0.003" solref="0.02 1"
            mass="0.010"/>
      <inertial pos="0 0 0" mass="0.010"
                diaginertia="8e-7 8e-7 8e-7"/>
    </body>

    <!-- Cameras -->
    <body name="cam_target" pos="0.50 0.0 0.42">
      <site name="cam_target_site" pos="0 0 0" size="0.001" rgba="0 0 0 0"/>
    </body>

    <!-- Agentview: elevated 3/4 angle -->
    <body name="cam_agent_body" pos="1.3 -0.8 1.1">
      <camera name="agentview" fovy="55" pos="0 0 0"
              mode="targetbody" target="cam_target"/>
    </body>

    <!-- Sideview: from the right side -->
    <body name="cam_side_body" pos="0.50 -1.2 0.7">
      <camera name="sideview" fovy="55" pos="0 0 0"
              mode="targetbody" target="cam_target"/>
    </body>

    <!-- Topview: directly overhead -->
    <body name="cam_top_body" pos="0.50 0.0 1.7">
      <camera name="topview" fovy="50" pos="0 0 0"
              mode="targetbody" target="cam_target"/>
    </body>
  </worldbody>

  <!-- Weld constraint: activated at runtime after right arm grasps brush.
       Locks brush body to R_hand so it can't slip during fast sweeps.
       The relative transform is captured when the weld is activated. -->
  <equality>
    <weld body1="brush" body2="R_hand" active="false"
          solref="0.01 1" solimp="0.95 0.99 0.001"/>
  </equality>

  <!--
    Keyframe: L arm (9 qpos) + R arm (9 qpos) + dustpan (7 free)
    + brush (7 free) + 4 debris (7 free each) = 18 + 7 + 7 + 28 = 60 qpos.
    Actuators: L (8) + R (8) = 16 ctrl values.
  -->
  <!--
    Keyframe: L arm (9 qpos) + R arm (9 qpos) + brush (7 free)
    + 4 debris (7 free each) = 18 + 7 + 28 = 53 qpos.
    Actuators: L (8) + R (8) = 16 ctrl values.
  -->
  <keyframe>
    <key name="home"
         qpos="0 -0.785 0 -2.356 0 1.571 0.785 0.04 0.04
               0 -0.785 0 -2.356 0 1.571 0.785 0.04 0.04
               0.45 -0.15 0.42 1 0 0 0
               0.45 -0.10 0.431 1 0 0 0
               0.47 -0.12 0.431 1 0 0 0
               0.43 -0.14 0.431 1 0 0 0
               0.46 -0.16 0.431 1 0 0 0"
         ctrl="0 -0.785 0 -2.356 0 1.571 0.785 255
               0 -0.785 0 -2.356 0 1.571 0.785 255"/>
  </keyframe>
</mujoco>
