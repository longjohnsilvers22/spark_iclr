<mujoco model="corl_mug_pour_realistic">
  <!--
    CoRL mug-handle pour demo — REALISTIC MUG with loop handle.
      - Panda arm at world origin.
      - Mug with loop handle: 80mm OD cylinder body (40mm radius, 90mm tall),
        handle formed by two horizontal posts + one vertical grip bar, creating
        a visible air gap (like a real mug handle loop).
      - Bowl: 200mm OD octagonal, 80mm tall. At (0.50, -0.22).
      - Cameras: agentview, sideview, topview.

    Handle geometry (viewed from +Y, looking down -Y axis):
        body  upper_post   grip_bar
        |====>============|
        |                 |  <- air gap
        |====>============|
        body  lower_post

    Capsule radius = 7mm (14mm diameter), graspable by Panda fingers.
    Grip bar center at (0.060, 0, 0.045) — close to original handle site.
    Air gap spans from z=0.022 to z=0.068 between mug body and grip bar.
  -->

  <compiler angle="radian" autolimits="true"
            meshdir="../../../mujoco_menagerie/franka_emika_panda/assets"/>

  <include file="_panda_base.xml"/>

  <visual>
    <headlight diffuse="0.4 0.4 0.4" ambient="0.2 0.2 0.2" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20" offwidth="800" offheight="600"/>
  </visual>

  <statistic center="0.4 0 0.5" extent="1.2"/>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.8"
             rgb2="0.1 0.2 0.4" width="512" height="3072"/>
    <texture type="2d" name="lab_floor" builtin="checker"
             rgb1="0.35 0.4 0.45" rgb2="0.25 0.3 0.35" width="512" height="512"
             mark="cross" markrgb="0.8 0.8 0.9"/>
    <material name="groundplane" texture="lab_floor" texrepeat="20 20"
              reflectance="0.3" shininess="0.1"/>

    <material name="table_mat" rgba="0.7 0.5 0.3 1" reflectance="0.4" shininess="0.3"/>
    <material name="mug_mat" rgba="0.8 0.2 0.2 1"
              specular="0.3" shininess="0.2" reflectance="0.1"/>
    <material name="bowl_mat" rgba="0.35 0.45 0.7 1"
              specular="0.6" shininess="0.4" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 4" dir="0 0 -1" directional="true" diffuse="0.5 0.5 0.5"/>
    <light pos="2 2 3" dir="-0.5 -0.5 -1" diffuse="0.25 0.25 0.25"/>
    <light pos="0 -2 3" dir="0 0.5 -1" diffuse="0.2 0.2 0.2"/>
    <geom name="floor" size="10 10 0.01" type="plane" material="groundplane"/>

    <!-- Table at z=0 in robot frame. -->
    <body name="table" pos="0.45 0 -0.01">
      <geom name="table_top" type="box" size="0.40 0.40 0.01"
            pos="0 0 0" material="table_mat"
            friction="1 0.5 0.0001"/>
    </body>

    <!--
      Mug with REALISTIC LOOP HANDLE.
      Body: cylinder 80mm OD (40mm radius), 90mm tall (45mm half-height).
      Handle: loop made from 3 capsule geoms forming a D-shape on the +X side.
        - Upper post:  horizontal capsule from body wall (x=0.040) to grip bar (x=0.060) at z=0.070
        - Lower post:  horizontal capsule from body wall (x=0.040) to grip bar (x=0.060) at z=0.020
        - Grip bar:    vertical capsule from (x=0.060, z=0.020) to (x=0.060, z=0.070)
        - Capsule radius: 0.007 (14mm diameter)
        - Air gap:     between posts, from mug body to grip bar (~13mm wide x ~36mm tall)
      Bottom on table at z=0; centre z=0.045; top z=0.090.
      Placed at (0.50, +0.20): offset for clear transit path to bowl.
      Handle points toward +X (away from robot base).

      Site "mug_handle_site" marks the grip bar center for IK targeting.
    -->
    <body name="mug" pos="0.50 0.20 0.0">
      <freejoint name="mug_free"/>

      <!-- Mug body: cylinder -->
      <geom name="mug_body" type="cylinder" size="0.040 0.045"
            pos="0 0 0.045" material="mug_mat"
            condim="6" friction="3 1.5 0.005"
            solimp="0.9 0.95 0.005" solref="0.02 1"/>

      <!-- Handle upper post: horizontal capsule, body wall to grip bar -->
      <geom name="mug_handle_upper" type="capsule" size="0.007"
            fromto="0.040 0 0.070  0.060 0 0.070" material="mug_mat"
            condim="6" friction="3 1.5 0.005"
            solimp="0.9 0.95 0.005" solref="0.02 1"/>

      <!-- Handle lower post: horizontal capsule, body wall to grip bar -->
      <geom name="mug_handle_lower" type="capsule" size="0.007"
            fromto="0.040 0 0.020  0.060 0 0.020" material="mug_mat"
            condim="6" friction="3 1.5 0.005"
            solimp="0.9 0.95 0.005" solref="0.02 1"/>

      <!-- Handle grip bar: vertical capsule on the outside -->
      <geom name="mug_handle_grip" type="capsule" size="0.007"
            fromto="0.060 0 0.020  0.060 0 0.070" material="mug_mat"
            condim="6" friction="3 1.5 0.005"
            solimp="0.9 0.95 0.005" solref="0.02 1"/>

      <!-- Handle grasp site at grip bar center -->
      <site name="mug_handle_site" pos="0.060 0 0.045" size="0.005"
            rgba="1 0.5 0 0.5" group="4"/>

      <!-- Mug mouth site at top rim -->
      <site name="mug_mouth" pos="0 0 0.090" size="0.035 0.035 0.001"
            rgba="0 0 0 0" type="box"/>

      <inertial pos="0 0 0.045" mass="0.20"
                diaginertia="0.00030 0.00030 0.00015"/>
    </body>

    <!--
      Bowl: 200mm OD, 80mm tall. At (0.50, -0.22).
    -->
    <body name="bowl" pos="0.50 -0.22 0.005">
      <geom name="bowl_bottom" type="cylinder" size="0.1 0.005"
            pos="0 0 0" material="bowl_mat"
            condim="6" friction="0.9 0.4 0.001"/>
      <!-- Octagonal wall -->
      <geom name="bowl_w0" type="box" size="0.039 0.0025 0.0375"
            pos="0.0975 0 0.0425" euler="0 0 1.5708" material="bowl_mat"/>
      <geom name="bowl_w1" type="box" size="0.039 0.0025 0.0375"
            pos="0.0689 0.0689 0.0425" euler="0 0 2.3562" material="bowl_mat"/>
      <geom name="bowl_w2" type="box" size="0.039 0.0025 0.0375"
            pos="0 0.0975 0.0425" euler="0 0 3.1416" material="bowl_mat"/>
      <geom name="bowl_w3" type="box" size="0.039 0.0025 0.0375"
            pos="-0.0689 0.0689 0.0425" euler="0 0 3.9270" material="bowl_mat"/>
      <geom name="bowl_w4" type="box" size="0.039 0.0025 0.0375"
            pos="-0.0975 0 0.0425" euler="0 0 1.5708" material="bowl_mat"/>
      <geom name="bowl_w5" type="box" size="0.039 0.0025 0.0375"
            pos="-0.0689 -0.0689 0.0425" euler="0 0 2.3562" material="bowl_mat"/>
      <geom name="bowl_w6" type="box" size="0.039 0.0025 0.0375"
            pos="0 -0.0975 0.0425" euler="0 0 3.1416" material="bowl_mat"/>
      <geom name="bowl_w7" type="box" size="0.039 0.0025 0.0375"
            pos="0.0689 -0.0689 0.0425" euler="0 0 3.9270" material="bowl_mat"/>
      <site name="bowl_target" pos="0 0 0.05" size="0.08 0.08 0.001"
            rgba="0 0 0 0" type="box"/>
    </body>

    <!-- Cameras -->
    <body name="cam_target" pos="0.45 0 0.05">
      <site name="cam_target_site" pos="0 0 0" size="0.001" rgba="0 0 0 0"/>
    </body>
    <body name="cam_agent_body" pos="1.4 0.0 0.8">
      <camera name="agentview" fovy="55" pos="0 0 0"
              mode="targetbody" target="cam_target"/>
    </body>
    <body name="cam_side_body" pos="0.45 -1.0 0.45">
      <camera name="sideview" fovy="55" pos="0 0 0"
              mode="targetbody" target="cam_target"/>
    </body>
    <body name="cam_top_body" pos="0.4 0 1.5">
      <camera name="topview" fovy="50" pos="0 0 0"
              mode="targetbody" target="cam_target"/>
    </body>
  </worldbody>

  <keyframe>
    <key name="home"
         qpos="0 -0.785 0 -2.356 0 1.571 0.785 0.04 0.04  0.50 0.20 0.045 1 0 0 0"
         ctrl="0 -0.785 0 -2.356 0 1.571 0.785 255"/>
  </keyframe>
</mujoco>
