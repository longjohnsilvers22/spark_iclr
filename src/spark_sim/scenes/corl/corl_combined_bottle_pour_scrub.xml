<mujoco model="corl_combined_bottle_pour_scrub">
  <!--
    CoRL Combined: bottle pour -> place back -> sponge scrub plate.
      - Panda arm at world origin.
      - Bottle: upright cylinder, 120mm tall, 60mm OD (30mm radius). On
        +Y side of plate at (0.50, +0.20). Half-height = 0.060 -> centre z = 0.060.
      - Plate: round dinner plate, 200mm OD (100mm radius), 12mm tall.
        Centred at (0.50, 0.00). Welded to world.
      - Sponge: yellow block 100mm (Y) x 60mm (X) x 30mm (Z). On -Y side
        at (0.50, -0.20). half height = 0.015 -> centre z = 0.015.
      - Cameras: agentview, sideview, topview.

    Trajectory the test exercises (in order):
      1.  start at home
      2.  ANGLED 45 grasp on bottle (pitch_rad = pi/4)
      3.  lift bottle to safe ceiling
      4.  translate to above plate
      5.  TILT over plate (~100 deg about local X) -> pour
      6.  un-tilt back to upright
      7.  translate back to bottle origin
      8.  descend, release bottle on table
      9.  retreat to safe ceiling
      10. translate to above sponge
      11. TOP DOWN grasp sponge
      12. lift, transit to above plate
      13. descend to scrub height
      14. 4-stroke XY scrub at constant Z
      15. lift, retreat
  -->

  <compiler angle="radian" autolimits="true"
            meshdir="../../../mujoco_menagerie/franka_emika_panda/assets"/>

  <include file="_panda_base.xml"/>

  <visual>
    <headlight diffuse="0.4 0.4 0.4" ambient="0.2 0.2 0.2" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20" offwidth="800" offheight="600"/>
  </visual>

  <statistic center="0.5 0 0.5" extent="1.3"/>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.8"
             rgb2="0.1 0.2 0.4" width="512" height="3072"/>
    <texture type="2d" name="lab_floor" builtin="checker"
             rgb1="0.35 0.4 0.45" rgb2="0.25 0.3 0.35" width="512" height="512"
             mark="cross" markrgb="0.8 0.8 0.9"/>
    <material name="groundplane" texture="lab_floor" texrepeat="20 20"
              reflectance="0.3" shininess="0.1"/>

    <material name="table_mat" rgba="0.7 0.5 0.3 1" reflectance="0.4" shininess="0.3"/>
    <material name="bottle_mat" rgba="0.15 0.55 0.30 1"
              specular="0.4" shininess="0.25" reflectance="0.1"/>
    <material name="bottle_cap_mat" rgba="0.6 0.6 0.65 1"
              specular="0.7" shininess="0.5" reflectance="0.2"/>
    <material name="sponge_mat" rgba="1.0 0.85 0.15 1"
              specular="0.05" shininess="0.05" reflectance="0.02"/>
    <material name="plate_mat" rgba="0.95 0.95 0.97 1"
              specular="0.7" shininess="0.6" reflectance="0.3"/>
  </asset>

  <worldbody>
    <light pos="0 0 4" dir="0 0 -1" directional="true" diffuse="0.5 0.5 0.5"/>
    <light pos="2 2 3" dir="-0.5 -0.5 -1" diffuse="0.25 0.25 0.25"/>
    <light pos="0 -2 3" dir="0 0.5 -1" diffuse="0.2 0.2 0.2"/>
    <geom name="floor" size="10 10 0.01" type="plane" material="groundplane"/>

    <!-- Table top at z=0 in robot frame (matches F1/F3 scene convention).
         Table slab centred at x=0.50 so it spans 0.05..0.95 in X and
         -0.40..+0.40 in Y. -->
    <body name="table" pos="0.50 0 -0.01">
      <geom name="table_top" type="box" size="0.45 0.45 0.01"
            pos="0 0 0" material="table_mat"
            friction="1 0.5 0.0001"/>
    </body>

    <!--
      Bottle: bottle-shaped (wide body + narrow neck) so the gripper has
      a positive shoulder feature to lock against during the 100 deg pour
      tilt.  Wide body 60 mm OD x 80 mm tall, neck 30 mm OD x 40 mm tall.
      Cap 44 mm OD x 12 mm.  Total height = 80 + 40 + 12 = 132 mm.
      Bottom on table; body centred at z = 0.040; neck centre at
      z = 0.100; cap centre at z = 0.126.  Mass = 0.20 kg.
      The gripper grasps the NECK at z ~= 0.095 (just below the cap),
      where the cap acts as a positive stop preventing the cylinder
      from slipping out of the jaws during pour-tilt.
    -->
    <body name="bottle" pos="0.50 0.20 0.0">
      <freejoint name="bottle_free"/>
      <geom name="bottle_body" type="cylinder" size="0.030 0.040"
            pos="0 0 0.040" material="bottle_mat"
            condim="6" friction="3 1.5 0.005"
            solimp="0.9 0.95 0.005" solref="0.02 1"/>
      <geom name="bottle_neck" type="cylinder" size="0.015 0.020"
            pos="0 0 0.100" material="bottle_mat"
            condim="6" friction="3 1.5 0.005"
            solimp="0.9 0.95 0.005" solref="0.02 1"/>
      <geom name="bottle_cap" type="cylinder" size="0.022 0.006"
            pos="0 0 0.126" material="bottle_cap_mat"
            condim="6" friction="3 1.5 0.005"
            solimp="0.9 0.95 0.005" solref="0.02 1"/>
      <inertial pos="0 0 0.055" mass="0.18"
                diaginertia="0.00040 0.00040 0.00018"/>
    </body>

    <!--
      Plate: 200mm OD (100mm radius), 12mm tall.  Welded (no freejoint)
      so scrub doesn't slide it around.  Centre z=0.006.
    -->
    <body name="plate" pos="0.50 0.0 0.0">
      <geom name="plate_geom" type="cylinder" size="0.10 0.006"
            pos="0 0 0.006" material="plate_mat"
            condim="6" friction="0.9 0.4 0.001"/>
      <site name="plate_centre" pos="0 0 0.013" size="0.005" rgba="0 1 0 0"/>
    </body>

    <!--
      Sponge: 60mm (X) x 100mm (Y) x 30mm (Z).  Long axis along world Y.
      Bottom on table; centre z = 0.015.
    -->
    <body name="sponge" pos="0.50 -0.20 0.015">
      <freejoint name="sponge_free"/>
      <geom name="sponge_geom" type="box" size="0.03 0.05 0.015"
            material="sponge_mat"
            condim="6" friction="3 1.5 0.005"
            solimp="0.9 0.95 0.005" solref="0.02 1"/>
      <inertial pos="0 0 0" mass="0.08"
                diaginertia="0.0001 0.00008 0.00012"/>
    </body>

    <!-- Cameras (targetbody mode) -->
    <body name="cam_target" pos="0.5 0 0.05">
      <site name="cam_target_site" pos="0 0 0" size="0.001" rgba="0 0 0 0"/>
    </body>
    <body name="cam_agent_body" pos="1.5 0.0 0.9">
      <camera name="agentview" fovy="55" pos="0 0 0"
              mode="targetbody" target="cam_target"/>
    </body>
    <body name="cam_side_body" pos="0.50 -1.2 0.45">
      <camera name="sideview" fovy="55" pos="0 0 0"
              mode="targetbody" target="cam_target"/>
    </body>
    <body name="cam_top_body" pos="0.5 0 1.6">
      <camera name="topview" fovy="50" pos="0 0 0"
              mode="targetbody" target="cam_target"/>
    </body>
  </worldbody>

  <keyframe>
    <key name="home"
         qpos="0 -0.785 0 -2.356 0 1.571 0.785 0.04 0.04  0.50 0.20 0.0 1 0 0 0  0.50 -0.20 0.015 1 0 0 0"
         ctrl="0 -0.785 0 -2.356 0 1.571 0.785 255"/>
  </keyframe>
</mujoco>
