# Machine-local config overlays and rig-specific family variants hold internal
# IPs / camera serials / calibration and must NOT ship. Kept on disk locally,
# excluded from the repo. The tracked configs/machines/example.yaml is the schema.
src/spark_real/configs/machines/*.yaml
!src/spark_real/configs/machines/example.yaml
!src/spark_real/configs/machines/ANON-LAB.example.yaml
src/spark_real/configs/*_ANON-LAB.yaml
